# Copy this file to .env and fill in real values. Never commit .env.
# Reading files into JSON (ami read / drive-read / gui) needs none of the
# model keys below - only the Drive settings if you read from Drive.

# ---- Google Drive ---------------------------------------------------------

# Drive folder used when --folder is omitted, and the GUI's default folder.
DRIVE_FOLDER_ID=

# OAuth client (Google Cloud Console -> Credentials -> "Desktop app").
# Needed for uploads, and enough on its own for reads too: sign in once
# with "Connect Google Drive" in the GUI or `ami drive-login`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional service account for read-only access (e.g. on a server with no
# signed-in user). Keep the key file out of the repo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# ---- Reading --------------------------------------------------------------

# Files above this size are read with byte-range requests instead of one
# full download (ZIP, DOCX, PPTX, XLSX, PDF).
RANGE_THRESHOLD_MB=32

# Largest file that may sit fully in memory (images, text, small PDFs).
MAX_IN_MEMORY_MB=200

# RAM all parallel reads may hold together when a folder is processed.
MEMORY_BUDGET_MB=512
READ_CONCURRENCY=3

# MarkItDown worker: auto (use it if Python + markitdown are installed) or off.
MARKITDOWN=auto
AMI_PYTHON_BIN=python3

# Keep extracted JSON across restarts, keyed by file content (MD5).
# Leave empty for an in-memory cache only.
CACHE_DIR=.cache/ami

# ---- GUI ------------------------------------------------------------------

GUI_HOST=127.0.0.1
GUI_PORT=4300
# Required if GUI_HOST is anything other than localhost. Open /?key=<value> once.
GUI_ACCESS_KEY=
MAX_UPLOAD_MB=1024

# ---- Image understanding (analyze / compare only) -------------------------

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-vl-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Longest side (px) an image is scaled down to before it goes to a model.
MAX_IMAGE_DIMENSION=2000

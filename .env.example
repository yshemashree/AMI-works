# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic (Claude) API key - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model used for image/document understanding.
CLAUDE_MODEL=claude-sonnet-5

# Alibaba DashScope (Qwen-VL) API key - https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# Qwen model used for image/document understanding.
QWEN_MODEL=qwen-vl-max

# Optional: override DashScope base URL (e.g. for the international endpoint).
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Max image dimension (longest side, px) before downscaling to keep API payloads reasonable.
MAX_IMAGE_DIMENSION=2000

# Directory used for extracted ZIP contents and rendered PDF pages.
WORK_DIR=.tmp

# Google service account key file used for Drive reads - keep it out of the repo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Drive folder read by drive-analyze and written to by drive-upload, used when --folder is omitted.
DRIVE_FOLDER_ID=

# OAuth client id for uploads, from a Desktop app client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=

# OAuth client secret that goes with the client id above.
GOOGLE_OAUTH_CLIENT_SECRET=
